# Copy to .env (git-ignored) and set the path of your local Seafile data folder.
# Absolute path or ~/...; quotes are needed when the path contains spaces.
# macOS example (SeaDrive): TATTOO_DATA_DIR="~/Your Secure Cloud/<library>/tattoo-planner-data"
TATTOO_DATA_DIR=

# Optional, for the "Edit images" tab (docs/adr/0007-image-edits.md):
# TATTOO_CLAUDE_BIN=claude                 Claude Code binary, if not on the PATH of npm run dev
# TATTOO_EDIT_MODEL=                       model passed to claude -p --model (default: your Claude Code default)
# TATTOO_EDIT_CACHE=~/.cache/tattoo-planner  where Claude may keep a Python virtualenv between edits

# Optional, generative edits with GPT Image (docs/adr/0008-generative-edits.md). Key from platform.openai.com.
# TATTOO_OPENAI_API_KEY=sk-proj-...
# TATTOO_OPENAI_MODEL=gpt-image-2.5-sunburst   or gpt-image-2.5-flare (faster)
# TATTOO_OPENAI_FIDELITY=high                  high | low | default (leave the field out)
# TATTOO_OPENAI_QUALITY=high                   high | medium | low | auto
