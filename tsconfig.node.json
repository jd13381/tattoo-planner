{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/server",
    "src/data/types.ts",
    "src/config",
    "src/assets/manifest.ts",
    "src/assets/manifestDoc.ts",
    "src/assets/scan.ts",
    "src/export/names.ts",
    "scripts/**/*.ts",
    "tests"
  ]
}
