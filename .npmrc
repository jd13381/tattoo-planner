# Same hardening as Job Radar: no lifecycle scripts, no versions younger than 7 days, no git dependencies.
# min-release-age and allow-git need npm 11; npm 10 ignores them.
# If a new dependency needs an install script, run `npm rebuild <pkg> --ignore-scripts=false` and say so in the PR.
ignore-scripts=true
min-release-age=7
allow-git=none
