# OS and editor
.DS_Store
.idea/
.vscode/

# Local config: TATTOO_DATA_DIR and anything personal (CLAUDE.md, docs/history/project-brief.md §12)
.env
.env.*
!.env.example

# Node and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Desktop app build output (docs/adr/0015-desktop-app.md): compiled shell, generated icon, DMGs.
dist-desktop/
release/
*.[dD][mM][gG]
*.[iI][cC][nN][sS]

# Exports are written to <TATTOO_DATA_DIR>/exports, never into the repo.
# These entries are defence in depth in case an export lands here by mistake.
exports/
**/exports/

# Images and PDFs never go into git (docs/history/project-brief.md §12.5).
# Character classes make the patterns case-insensitive (photo.JPEG, scan.PDF).
# The pre-commit guard (scripts/check-binaries.mjs) enforces the same rule for force-added files.
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[wW][eE][bB][pP]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[gG][iI][fF]
*.[aA][vV][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[pP][sS][dD]
*.[pP][dD][fF]

# The one image exception (docs/adr/0019, Jan, 2026-11-06): generated standard background tiles.
# The pre-commit guard limits them to PNG/WebP directly in this folder, 2 MB each.
!assets/backgrounds/*.[pP][nN][gG]
!assets/backgrounds/*.[wW][eE][bB][pP]

# The second exception (docs/adr/0026, Jan, 2026-11-15): README screenshots of the sample project,
# written by `npm run screenshots`. WebP only, at most 500 KB each (pre-commit guard).
!docs/screenshots/*.[wW][eE][bB][pP]

# Python bytecode (benchmark scripts)
__pycache__/
